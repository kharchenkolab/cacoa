  covariate.sets = "auto",
  screen.name = "covariate.screen",
  top.k = 3,
  name = "sensitivity",
  shifts.name = "expression.shifts",
  n.permutations = NULL,
  verbose = NULL,
  n.cores = NULL,
  seed = NULL
)}\if{html}{\out{</div>}}
}

